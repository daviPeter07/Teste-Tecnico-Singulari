@baseUrl = http://localhost:3333
@userEmail = userteste@teste.com
@userPassword = strong-password

###
# Antes de executar este arquivo:
# 1. Suba postgres e redis
# 2. Suba a API
# 3. Suba o worker
# 4. Garanta que o seed ja foi executado

###
# Criar conta (roda uma vez)
# @name register
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Test",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "confirmPassword": "{{userPassword}}"
}

###
# Login
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

###
# Obter perfil do usuario autenticado
# @name myProfile
GET {{baseUrl}}/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Conferir noticias antes da curadoria
GET {{baseUrl}}/news?page=1&limit=10
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Disparar a curadoria
# @name runCuration
POST {{baseUrl}}/curation/run
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "sourceType": "template",
  "limit": 5
}

###
# Consultar status da execucao
GET {{baseUrl}}/curation/runs/{{runCuration.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Aguarde 2-5 segundos para o worker consumir a fila e rode o status novamente.

###
# Conferir noticias apos a curadoria
GET {{baseUrl}}/news?page=1&limit=10
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Conferir noticias de IA
GET {{baseUrl}}/news?page=1&limit=10&category=artificial-intelligence
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Conferir noticias de backend
GET {{baseUrl}}/news?page=1&limit=10&category=backend
Authorization: Bearer {{login.response.body.$.accessToken}}
