@baseUrl = http://localhost:3333
@userName = User teste
@userEmail = userteste@teste.com
@userPassword = strong-password

###
# Antes de executar:
# 1. docker compose up (ou postgres + redis + api + worker)
# 2. Migration e seed aplicados

###
# Health check
GET {{baseUrl}}/health

###
# Noticias publicas sem token
GET {{baseUrl}}/news

###
# Cadastro (roda uma vez; se ja existir, a API retorna 409)
# @name register
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "{{userName}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "confirmPassword": "{{userPassword}}"
}

###
# Login
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

###
# Perfil do usuario autenticado
GET {{baseUrl}}/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Listar categorias disponiveis
# @name listAvailablePreferences
GET {{baseUrl}}/preferences
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Atualizar preferencias do usuario
PUT {{baseUrl}}/users/me/preferences
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryIds": [
    "{{listAvailablePreferences.response.body.$[0].id}}",
    "{{listAvailablePreferences.response.body.$[1].id}}"
  ]
}

###
# Noticias antes da curadoria
GET {{baseUrl}}/news?page=1&limit=10

###
# Noticias publicas filtradas por periodo (requisito essencial do PDF)
GET {{baseUrl}}/news?page=1&limit=10&period=week

###
# Disparar curadoria com templates deterministicos
# @name runTemplateCuration
POST {{baseUrl}}/curation/run
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "sourceType": "template",
  "limit": 5
}

###
# Disparar curadoria high-code a partir de sinais locais em JSON
# Recomendado para demonstrar o requisito obrigatorio do agente no PDF.
# @name runLocalJsonCuration
POST {{baseUrl}}/curation/run
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "sourceType": "local-json",
  "limit": 5
}

###
# Status da execucao template
GET {{baseUrl}}/curation/runs/{{runTemplateCuration.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Status da execucao local-json
GET {{baseUrl}}/curation/runs/{{runLocalJsonCuration.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# (Aguarde 2-5s e rode os status novamente ate COMPLETED ou PARTIAL)
# Se OPENROUTER estiver configurado, o consumidor deve gerar summaries reais no worker.

###
# Noticias apos curadoria
GET {{baseUrl}}/news?page=3&limit=10

###
# Noticias apos curadoria filtradas por periodo
GET {{baseUrl}}/news?page=1&limit=10&period=week

###
# Noticias filtradas por categoria
GET {{baseUrl}}/news?page=1&limit=10&category=artificial-intelligence

###
# Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Noticias continuam publicas apos logout
GET {{baseUrl}}/news
