@baseUrl = http://localhost:3333
@userName = User teste
@userEmail = userteste@teste.com
@userPassword = strong-password

###
# Publico: raiz
GET {{baseUrl}}/

###
# Publico: health check
GET {{baseUrl}}/health

###
# Protegido: deve retornar 401 sem token
GET {{baseUrl}}/news

###
# Cadastro
# Se este usuario ja existir, a API deve retornar 409.
# Nesse caso, siga com o login abaixo.
# @name register
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "{{userName}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "confirmPassword": "{{userPassword}}"
}

###
# Login
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

###
# Lista categorias/preferencias disponiveis
# @name listAvailablePreferences
GET {{baseUrl}}/preferences
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Atualiza preferencias do usuario autenticado
# Usa as 2 primeiras categorias retornadas por /preferences
# @name updateMyPreferences
PUT {{baseUrl}}/users/me/preferences
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryIds": [
    "{{listAvailablePreferences.response.body.$[0].id}}",
    "{{listAvailablePreferences.response.body.$[1].id}}"
  ]
}

###
# Consulta preferencias atuais do usuario
GET {{baseUrl}}/users/me/preferences
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Consulta noticias autenticado
GET {{baseUrl}}/news?page=1&limit=10&period=week
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Consulta noticias autenticado com filtro por categoria
GET {{baseUrl}}/news?page=1&limit=10&category={{listAvailablePreferences.response.body.$[0].slug}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Logout da sessao atual
# @name logout
POST {{baseUrl}}/logout
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# Protegido: deve retornar 401 apos logout
GET {{baseUrl}}/news
Authorization: Bearer {{login.response.body.$.accessToken}}
